{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "laravel-modules-arch module manifest",
    "description": "Schema for a Bounded Context's module.json manifest. Permissive at the root so nwidart-specific keys (files, keywords, etc.) pass through unchanged.",
    "type": "object",
    "required": ["name", "providers"],
    "properties": {
        "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "description": "StudlyCase module name."
        },
        "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "snake_case alias used in nwidart commands and morph keys."
        },
        "description": {
            "type": "string"
        },
        "priority": {
            "type": "integer",
            "minimum": 0
        },
        "version": {
            "type": "string"
        },
        "providers": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1,
            "description": "Fully-qualified ServiceProvider classes registered by the module."
        },
        "contracts": {
            "type": "object",
            "properties": {
                "publishes": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": "FQCNs from Contracts/ exposed as the module's public API."
                }
            },
            "additionalProperties": false
        },
        "events": {
            "type": "object",
            "properties": {
                "publishes": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": "Integration Events (Contracts/Events/) emitted by this module."
                },
                "subscribes": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": "Integration Events this module listens to (must be Contracts/Events/ of other modules)."
                }
            },
            "additionalProperties": false
        },
        "dependencies": {
            "type": "object",
            "properties": {
                "required": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": "Modules that must be enabled for this module to work."
                },
                "optional": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": "Modules referenced via ModuleAwareRelation/CrossModuleAction."
                }
            },
            "additionalProperties": false
        }
    }
}
